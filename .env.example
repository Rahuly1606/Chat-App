# Neon CLI supplies these values after `neon deploy`.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=verify-full

# Backend-only values.
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend build-time values for split deployments.
VITE_API_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001
